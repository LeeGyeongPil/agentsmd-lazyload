{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Bash|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/dist/cli.js\" hook",
            "timeout": 10,
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Bash|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/dist/cli.js\" hook",
            "timeout": 10,
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/dist/cli.js\" hook",
            "timeout": 10,
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
