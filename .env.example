# All variables are optional. agentsmd-lazyload needs no API key and no network.
# Output language: en or ko (the --lang flag wins over this)
AGENTSMD_LAZYLOAD_LANG=
# Session state directory (default: $XDG_STATE_HOME/agentsmd-lazyload or ~/.local/state/agentsmd-lazyload)
AGENTSMD_LAZYLOAD_STATE_DIR=
# Comma-separated folder names to skip (default: node_modules,.venv,venv,vendor,third_party,.git,dist,build)
AGENTSMD_LAZYLOAD_EXCLUDE=
# 1 = the hook does nothing (escape hatch if Codex adds native nested loading)
AGENTSMD_LAZYLOAD_DISABLE=
# Codex home holding config.toml (default: ~/.codex)
CODEX_HOME=
